{
  "name": "mcp-to-skill",
  "version": "0.3.0",
  "type": "module",
  "description": "Convert MCP servers to Claude Skills with progressive disclosure",
  "repository": {
    "type": "git",
    "url": "https://github.com/larkinwc/ts-mcp-to-skill.git"
  },
  "homepage": "https://github.com/larkinwc/ts-mcp-to-skill#readme",
  "bugs": {
    "url": "https://github.com/larkinwc/ts-mcp-to-skill/issues"
  },
  "author": "larkinwc",
  "bin": {
    "mcp-to-skill": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "mcp",
    "claude",
    "skill",
    "model-context-protocol",
    "anthropic"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
